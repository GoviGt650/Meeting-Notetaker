# ─── Google OAuth / Meet API ───────────────────────────────────────────────
# Required: Create a GCP project and enable the Google Meet REST API
# (conferenceRecords), then create OAuth 2.0 credentials.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# ─── LLM (OpenAI-compatible) ───────────────────────────────────────────────
# Used for meeting summarization. Compatible with OpenAI directly or
# any OpenAI-compatible endpoint (OpenRouter, Together, Groq, etc.)
OPENAI_API_KEY=your-openai-api-key

# Optional: Override the base URL to use OpenRouter or another provider
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model to use for summarization
LLM_MODEL=gpt-4o-mini

# ─── Database ─────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./data/notetaker.db

# PostgreSQL (production alternative):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/notetaker

# ─── Application ──────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# CORS — add your frontend origin in production
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
